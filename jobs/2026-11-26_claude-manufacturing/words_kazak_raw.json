 "language_probability": 0.9997987151145935,
 "segments": [
  {
   "start": 0.8600000000000003,
   "end": 5.72,
   "text": "Claude just got a job on the factory floor. Anthropic launched Claude for manufacturing,"
  },
  {
   "start": 6.22,
   "end": 11.6,
   "text": "a plugin with 17 ready-made skills. Here's what that means. A part fails inspection."
  },
  {
   "start": 12.22,
   "end": 17.16,
   "text": "Claude writes the non-conformance report, checks past failures, ranks the likely causes,"
  },
  {
   "start": 17.58,
   "end": 23.08,
   "text": "and drafts the 8D. The quality engineer just reviews and signs. An RFQ comes in."
  },
  {
   "start": 23.56,
   "end": 27.64,
   "text": "Claude flags what is missing from the drawing and drafts the quote from your cost history."
  },
  {
   "start": 27.64,
   "end": 34.8,
   "text": "It connects to Autodesk Fusion, In4, Microsoft 365, and NetSuite. And it never runs your machines."
  },
  {
   "start": 35.52,
   "end": 39.16,
   "text": "A human signs off on everything. And do you know what the best part is?"
  },
  {
   "start": 39.54,
   "end": 43.32,
   "text": "Skills are just folders. Your team can rewrite them for its own procedures."
  },
  {
   "start": 43.98,
   "end": 46.06,
   "text": "Want me to show you how to build one? Comment skill."
  }
 ],
