 "segments": [
  {
   "start": 0.0,
   "end": 3.64,
   "text": "What if the system your plant runs on has no ready-made connector?"
  },
  {
   "start": 4.2,
   "end": 6.92,
   "text": "The custom connector skill is for exactly this."
  },
  {
   "start": 7.4,
   "end": 11.88,
   "text": "The custom connector skill, it works out with you how to reach a system that has no connector."
  },
  {
   "start": 12.2,
   "end": 14.84,
   "text": "An export, an API, a database view."
  },
  {
   "start": 15.3,
   "end": 17.2,
   "text": "It drafts the steps and settings."
  },
  {
   "start": 17.92,
   "end": 21.92,
   "text": "Turning the connection on still happens with you and your IT team's approval."
  },
  {
   "start": 22.52,
   "end": 23.68,
   "text": "Claude maps the route."
  },
  {
   "start": 24.16,
   "end": 25.88,
   "text": "Where would this skill help in your plant?"
  },
  {
   "start": 26.42,
   "end": 29.76,
   "text": "Comment skill for the link and follow for the next one."
  }
 ],
